+def rt_cfg_path():
+    return Path(os.environ.get("BB_RT_CFG") or DATA_DIR / "rt.cfg")
+
+
+def save_rt_cfg(s):
+    """Rewrites the live switches in BB_RT_CFG in place, keeping every other line (per-map keys,
+    hand tuning). Replaced in one step: the game polls the file and must never see half of it."""
+    values = {var: "1" if s[key] else "0" for key, var, *_ in RT_LIVE}
+    path = rt_cfg_path()
+    try:
+        lines = path.read_text(encoding='utf-8').splitlines()
+    except OSError:
+        lines = []
+    out, written = [], set()
+    for line in lines:
+        stripped = line.strip()
+        key = stripped.split("=", 1)[0].strip() if "=" in stripped and stripped[0] not in "#;" else None
+        if key in values:
+            out.append(f"{key}={values[key]}")
+            written.add(key)
+        else:
+            out.append(line)
+    out += [f"{key}={value}" for key, value in values.items() if key not in written]
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temp = path.with_name(path.name + ".tmp")
+    temp.write_text("\n".join(out) + "\n", encoding='utf-8')
+    os.replace(temp, path)
+
+
 def patches_dir(settings):
     return Path(settings.get("patches_dir") or DATA_DIR / "patches").expanduser()
 
