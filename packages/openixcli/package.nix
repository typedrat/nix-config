{
  lib,
  fetchFromGitHub,
  rustPlatform,
  pkg-config,
  libusb1,
}: let
  libefexRev = "3752e38ff8e69190c53cd43290a8102beab55e73";

  # libefex-sys's build script compiles C sources from two directories above
  # the crate, which vendoring would leave behind, so the dependency has to be
  # a path into a complete checkout. Its libusb submodule is only a fallback
  # for when pkg-config can't find a system libusb.
  libefex = fetchFromGitHub {
    owner = "YuzukiTsuru";
    repo = "libefex";
    rev = libefexRev;
    hash = "sha256-Auvwy4yiX8x7HxYJdvAXBAo6gFrdA1OeU8INLrZvqfs=";
  };
in
  rustPlatform.buildRustPackage (finalAttrs: {
    pname = "openixcli";
    version = "0.2.4";

    src = fetchFromGitHub {
      owner = "YuzukiTsuru";
      repo = "OpenixCLI";
      tag = "v${finalAttrs.version}";
      hash = "sha256-5mthkuXURdkoGx39T9ESQdA/KHFIR7ZfPff/dn0oILg=";
    };

    # Upstream doesn't commit a lockfile. This one is generated by update.sh
    # against the manifest as rewritten below.
    cargoLock.lockFile = ./Cargo.lock;

    # Matching the rev exactly makes the build fail, rather than silently use
    # a stale libefex, if upstream moves its pin.
    postPatch = ''
      substituteInPlace Cargo.toml \
        --replace-fail 'git = "https://github.com/YuzukiTsuru/libefex"' 'path = "${libefex}/rust/libefex"' \
        --replace-fail 'rev = "${libefexRev}"' ""
      ln -s ${./Cargo.lock} Cargo.lock
    '';

    nativeBuildInputs = [
      pkg-config
    ];

    buildInputs = [
      libusb1
    ];

    passthru.updateScript = ./update.sh;

    meta = {
      description = "CLI and TUI tool for flashing firmware to Allwinner devices over FEL and FES";
      homepage = "https://github.com/YuzukiTsuru/OpenixCLI";
      license = lib.licenses.mit;
      mainProgram = "openixcli";
      inherit (libusb1.meta) platforms;
    };
  })
