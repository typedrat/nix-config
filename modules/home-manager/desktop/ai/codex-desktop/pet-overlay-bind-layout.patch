+// Some bundles inline the whole layout computation as a plain function that
+// getLayoutForDisplay calls and returns. The this.* calls injected below then
+// run inside it with an undefined receiver, so call it with the controller.
+function bindReturnedFunction(text, head) {
+  const start = `${head}return function(`;
+  if (!text.startsWith(start) || text[start.length] !== "{") return text;
+  const paramsClose = findMatchingBrace(text, start.length);
+  if (paramsClose < 0 || text.slice(paramsClose + 1, paramsClose + 3) !== "){") return text;
+  const bodyClose = findMatchingBrace(text, paramsClose + 2);
+  if (bodyClose < 0 || text[bodyClose + 1] !== "(") return text;
+  return `${text.slice(0, bodyClose + 1)}.call(this,${text.slice(bodyClose + 2)}`;
+}
