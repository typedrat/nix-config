# Machine-wide coding agent configuration.
#
# Claude Code reads /etc/claude-code/managed-settings.d/*.json above every
# user's own settings. List keys such as hooks and permissions.allow merge
# with the user's, and scalar keys set here can't be changed from the UI, so
# only policy belongs here; theme, model and plugins stay in each user's
# writable ~/.claude/settings.json.
{
  config,
  lib,
  pkgs,
  ...
}: let
  inherit (lib) mkEnableOption mkIf mkOption types;
  cfg = config.rat.ai;

  aiUsers =
    lib.filterAttrs
    (_: u: u.enable && (u.cli.enable or false) && (u.cli.ai.enable or false))
    config.rat.users;

  mkGuard = name:
    pkgs.writeShellApplication {
      inherit name;
      runtimeInputs = with pkgs; [gnugrep jq];
      # The scripts exit 0 on every unmatched path; errexit would turn a
      # non-matching grep into a hook failure.
      bashOptions = ["nounset" "pipefail"];
      text = builtins.readFile ./hooks/${name}.sh;
    };

  command = cmd: extra: {
    hooks = [
      ({
          type = "command";
          command = cmd;
        }
        // extra)
    ];
  };

  # peon.sh is linked per user by home-manager, so users who haven't enabled
  # peon-ping get a no-op instead of a missing-command hook error.
  peonHook = pkgs.writeShellScript "peon-ping-hook" ''
    hook="''${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/peon-ping/peon.sh"
    [ -x "$hook" ] || exit 0
    exec "$hook"
  '';
  peonEvent = matcher: async:
    {inherit matcher;}
    // command (toString peonHook) ({timeout = 10;} // lib.optionalAttrs async {inherit async;});
in {
  options.rat.ai = {
    enable =
      mkEnableOption "machine-wide coding agent configuration"
      // {default = aiUsers != {};};

    gstack.enable =
      mkEnableOption "gstack skills and hooks"
      // {default = lib.meta.availableOn pkgs.stdenv.hostPlatform pkgs.gstack;};

    claude-code.settings = mkOption {
      type = types.attrsOf (pkgs.formats.json {}).type;
      default = {};
      description = ''
        Claude Code managed-settings fragments, one file each under
        /etc/claude-code/managed-settings.d, keyed by file name without the
        .json suffix. Claude Code merges them in name order.
      '';
    };
  };

  config = mkIf cfg.enable {
    rat.ai.claude-code.settings = lib.mkMerge [
      {
        "00-base" = {
          attribution = {
            commit = "";
            pr = "";
            sessionUrl = false;
          };
          cleanupPeriodDays = 3650;
        };

        "10-guards".hooks.PreToolUse = [
          ({matcher = "Bash";} // command (lib.getExe (mkGuard "block-find-root")) {timeout = 5;})
          ({matcher = "Bash|Monitor";} // command (lib.getExe (mkGuard "block-pgrep-self-wait")) {timeout = 5;})
        ];
      }

      (mkIf (lib.any (u: u.cli.ai.peon-ping.enable or false) (lib.attrValues aiUsers)) {
        "30-peon-ping".hooks = {
          SessionStart = [(peonEvent "" false)];
          SessionEnd = [(peonEvent "" true)];
          SubagentStart = [(peonEvent "" true)];
          SubagentStop = [(peonEvent "" true)];
          UserPromptSubmit = [(peonEvent "" true)];
          Stop = [(peonEvent "" true)];
          Notification = [(peonEvent "" true)];
          PermissionRequest = [(peonEvent "" true)];
          PostToolUseFailure = [(peonEvent "Bash" true)];
          PreCompact = [(peonEvent "" true)];
        };
      })
    ];

    # Each drop-in is copied rather than linked: Claude Code warns about a
    # managed file whose link leads out of /etc/claude-code.
    environment.etc =
      lib.mapAttrs' (name: value:
        lib.nameValuePair "claude-code/managed-settings.d/${name}.json" {
          text = builtins.toJSON value;
          mode = "0444";
        })
      cfg.claude-code.settings
      // lib.optionalAttrs cfg.gstack.enable {
        # Generated by gstack's own setup during the package build.
        "claude-code/managed-settings.d/20-gstack.json" = {
          source = "${pkgs.gstack}/share/gstack-hosts/claude/managed-settings.json";
          mode = "0444";
        };
      };
  };
}
